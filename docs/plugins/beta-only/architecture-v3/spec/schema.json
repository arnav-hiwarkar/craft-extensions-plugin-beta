  "layer_order": [
    "libs",
    "platform",
    "sdk",
    "adapter",
    "app",
    "tool",
    "plugin"
  ],
  "owner_rule_decisions": {
    "network": "DEC-COM-no-plugin-network"
  },
  "banned_text": [
    "\\bdefer(red|ral|s)?\\b",
    "\\blater (phase|release|version|milestone)\\b",
    "\\bfuture work\\b",
    "\\bTBD\\b",
    "\\bTODO\\b",
    "\\bnot (yet|now) (supported|built|implemented)\\b",
    "\\bout of scope\\b",
    "\\bpost-(beta|v1|launch)\\b",
    "\\bnice to have\\b",
    "\\bstretch goal\\b",
    "\\bv3 will\\b"
  ],
  "banned_allow_ids": [
    "^DEC-COM-no-plugin-network$",
    "no-deferral"
  ],
  "network_text": "\\bnet\\.(fetch|local)\\b|\\bnetwork:[a-z*]|\\boauth\\b|\\bplugin secrets?\\b|\\bremote content\\b|\\bmodel downloads?\\b",
  "network_perm_name": "^(net\\.|network:|secrets?\\.|oauth)",
