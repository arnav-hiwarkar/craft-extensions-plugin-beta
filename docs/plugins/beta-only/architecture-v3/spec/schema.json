{
  "id_pattern": "^(REQ|API|INC|CAP|OP|PERM|CON|CMP|DEC|TST|QAS|FLG|WS|TERM)-(COM|SEC|EC|PC|FC|AE|PS|FG)-[a-z0-9][a-z0-9._@:/+-]{0,63}$",
  "areas": [
    "core",
    "ui",
    "data",
    "sec",
    "ec-render",
    "ec-motion",
    "pc-pixel",
    "pc-doc",
    "fc",
    "plan"
  ],
  "status": [
    "spec",
    "decided",
    "open-owner",
    "proposed",
    "retired"
  ],
  "caps": {
    "title": 90,
    "name": 80,
    "stmt": 420,
    "detail": 1400,
    "measure": 300,
    "budget": 200,
    "choice": 300,
    "rationale": 500,
    "def": 300,
    "stimulus": 200,
    "response": 200,
    "sig": 300,
    "evidence": 300
  },
  "list_caps": {
