          "TST"
        ]
      },
      "nonempty": [
        "verified_by"
      ]
    },
    "API": {
      "file": "api.jsonl",
      "required": [
        "stmt",
        "evidence"
      ],
      "refs": {
        "caps": [
          "CAP"
        ],
        "decisions": [
          "DEC"
        ]
      },
      "nonempty": [
        "caps"
      ]
    },
    "INC": {
      "file": "inc.jsonl",
      "required": [
        "stmt",
        "evidence",
        "rank"
      ],
      "refs": {
